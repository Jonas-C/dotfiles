{
  "$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT",
  },
  "workspace": {
    "library": [
      // Runtime and builtin libraries.
      "$VIMRUNTIME/lua",
      "$XDG_DATA_HOME/nvim/lazy",
      "${3rd}/luv/library",
    ],
  },
  "diagnostics.globals": ["Snacks"],
}
